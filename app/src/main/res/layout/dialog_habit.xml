<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:padding="16dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Habit Name"
			android:textColor="@color/dark_text"
			android:textSize="16sp"
			android:textStyle="bold"
			android:layout_marginBottom="8dp" />

		<EditText
			android:id="@+id/input_habit_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="Enter habit name"
			android:inputType="textCapSentences"
			android:layout_marginBottom="16dp" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Selected Date"
			android:textColor="@color/dark_text"
			android:textSize="16sp"
			android:textStyle="bold"
			android:layout_marginBottom="8dp" />

		<TextView
			android:id="@+id/text_selected_date"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Today"
			android:textColor="@color/teal_primary"
			android:textSize="14sp"
			android:layout_marginBottom="16dp"
			android:background="@drawable/bg_card"
			android:padding="12dp" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Choose Icon"
			android:textColor="@color/dark_text"
			android:textSize="16sp"
			android:textStyle="bold"
			android:layout_marginBottom="8dp" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_icons"
			android:layout_width="match_parent"
			android:layout_height="120dp"
			android:layout_marginBottom="16dp" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Selected Icon Preview"
			android:textColor="@color/dark_text"
			android:textSize="14sp"
			android:layout_marginBottom="8dp" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:background="@drawable/bg_card"
			android:padding="16dp"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/image_selected_icon"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:src="@drawable/ic_water"
				android:layout_marginEnd="12dp" />

			<TextView
				android:id="@+id/text_icon_name"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Water"
				android:textColor="@color/dark_text"
				android:textSize="16sp" />

		</LinearLayout>

	</LinearLayout>

</ScrollView>
