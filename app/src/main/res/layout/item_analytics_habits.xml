<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/text_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Habits Report"
        android:textColor="@color/dark_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completion Rate"
            android:textColor="@color/dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_completion_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15/20 (75%)"
            android:textColor="@color/teal_primary"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak Information"
            android:textColor="@color/dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_streak_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best: 12 days | Current: 5 days"
            android:textColor="@color/soft_orange_secondary"
            android:textSize="16sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_daily_avg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Averages"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layout_daily_averages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Daily averages will be populated dynamically -->

    </LinearLayout>

</LinearLayout>