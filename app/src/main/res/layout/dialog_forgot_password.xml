<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/dark_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your email address to reset your password"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:gravity="center"
        android:alpha="0.7"
        android:layout_marginBottom="20dp" />

    <!-- Email Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/dark_text"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_reset_email"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:drawable/edit_text"
        android:hint="Enter your email"
        android:padding="16dp"
        android:inputType="textEmailAddress"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <!-- New Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Password"
        android:textColor="@color/dark_text"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_new_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:drawable/edit_text"
        android:hint="Enter new password"
        android:padding="16dp"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Confirm Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:textColor="@color/dark_text"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:drawable/edit_text"
        android:hint="Confirm new password"
        android:padding="16dp"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel_reset"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/light_gray_bg"
            android:layout_marginEnd="8dp"
            android:minWidth="100dp" />

        <Button
            android:id="@+id/btn_reset_password"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Reset Password"
            android:textColor="@color/white"
            android:backgroundTint="@color/teal_primary"
            android:minWidth="120dp" />

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>